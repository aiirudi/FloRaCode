# FloRaClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
FLORA_HOST=127.0.0.1
FLORA_PORT=7437

# ── Logging ───────────────────────────────────────────────────
FLORA_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
FLORA_LOG_FILE=~/.flora/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
FLORA_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# FLORA_CONFIG=~/.flora/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# FLORA_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# FLORA_MAX_STEPS=20
